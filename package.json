{
  "name": "bourse-radar-api",
  "version": "0.1.0",
  "description": "Bourse Radar API - Tehran Stock Exchange quantitative ranking engine",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#config": "./src/config/index.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts",
    "#db/*": "./src/db/*.ts",
    "#cache/*": "./src/cache/*.ts",
    "#scrapers/*": "./src/scrapers/*.ts",
    "#services/*": "./src/services/*.ts",
    "#routes/*": "./src/routes/*.ts",
    "#plugins/*": "./src/plugins/*.ts",
    "#jobs/*": "./src/jobs/*.ts",
    "#migrations/*": "./src/migrations/*.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "dev:api": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "dev:test": "vitest watch src",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch src",
    "test:cover": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docker:build": "docker build -t bourse-radar-api .",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/error": "^4.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.1",
    "bullmq": "^5.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "ioredis": "^5.4.0",
    "node-cron": "^3.0.3",
    "openai": "^5.0.0",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true
  }
}
