# روی سرور Coolify، به صورت دستی اجرا کن:
docker run --rm -it node:22-bookworm-slim bash

# داخل کانتینر:
time curl -I https://registry.npmmirror.com
# اگر > ۵ ثانیه بود، مشکل شبکه‌ی سرور است (نه Docker)

# تست npm با mirror:
mkdir /tmp/test && cd /tmp/test
echo "registry=https://registry.npmmirror.com" > .npmrc
npm install fastify --no-audit --no-fund